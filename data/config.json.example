{
  "device": {
    "id": "esp32_device_001",
    "name": "My E-Paper Display",
    "display_variant": "YOUR_PLATFORMIO_ENV_NAME",
    "_comment": "display_variant REQUIRED for OTA updates. Must match your compiled firmware environment. Valid values: lilygo_t5_depg_bw (BW default), lilygo_t5_gdew_bw (BW), lilygo_t5_gdem_4g (4G grayscale), lilygo_t5_gdew_4g (4G grayscale), lilygo_t5_gdey_4g (4G fast), lilygo_t5_v231 (legacy BW), lilygo_t5_213 (legacy BW), lilygo_t5s_27 (legacy 2.7\" BW). See platformio.ini [env:xxx] sections."
  },
  "wifi": {
    "timeout_ms": 20000,
    "force_high_power": false,
    "escalation_threshold": 3,
    "max_failed_wakes": 20,
    "_comment": "TX power: By default (false), uses adaptive mode starting at LOW (11dBm) for ~40% WiFi battery savings, auto-escalating to MEDIUM/HIGH if connection fails. Set true to always use HIGH (19.5dBm). After 20 failed wakes, enters low-power fallback mode (60min sleep, retries every 6h)."
  },
  "server": {
    "host": "YOUR_SERVER_URL",
    "port": 443,
    "path": "/ws-stream",
    "use_ssl": true
  },
  "display": {
    "rotation": 1
  },
  "security": {
    "use_aes": true,
    "aes_key": "YOUR_32_BYTE_HEX_AES_KEY_HERE"
  },
  "power": {
    "sleep_enabled": true,
    "sleep_duration_min": 1
  },
  "logging": {
    "default_level": "WARN",
    "enable_test_commands": false
  },
  "timezone": {
    "sync_interval_hours": 24
  },
  "quiet_hours": {
    "start_hour": 23,
    "end_hour": 7,
    "sleep_multiplier": 6,
    "_comment": "Quiet hours extend sleep duration for battery savings. Weekdays: 11PM-7AM use 30-min sleep (1min x 6). Weekends: ALL DAY 30-min sleep for ~20% battery savings."
  },
  "display_policy": {
    "skip_refresh_on_no_message": true,
    "_comment": "skip_refresh_on_no_message saves battery by only refreshing when new reactions arrive or power state changes."
  }
}
